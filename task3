#include <iostream>
#include <cstring>
using namespace std;

char* left(const char* target, const int count) {
    int len = strlen(target);
    
    // التحقق من تجاوز النطاق
    if (count < 0 || count > len) {
        cout << "Error: Out of range count!" << endl;
        return nullptr;
    }

    // تخصيص ذاكرة للسلسلة المقتطعة (+1 للحرف الملغي '\0')
    char* result = new char[count + 1];
    
    for (int i = 0; i < count; i++) {
        result[i] = target[i];
    }
    result[count] = '\0'; // إنهاء السلسلة النصية

    return result;
}

void Destructor(char* p) {
    if (p != nullptr) {
        delete[] p;
    }
}

int main() {
    char str[30];
    int count;

    cout << "Enter a string: ";
    cin.getline(str, 30);

    cout << "Enter count: ";
    cin >> count;

    char* subStr = left(str, count);

    if (subStr != nullptr) {
        cout << "Left substring: " << subStr << endl;
        Destructor(subStr); // تحرير الذاكرة المخصصة للدالة
    }

    return 0;
}
