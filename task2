#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter size of square matrix (N x N): ";
    cin >> n;

    // حجز مصفوفة ثنائية الأبعاد ديناميكياً
    int** matrix = new int*[n];
    for (int i = 0; i < n; i++) {
        matrix[i] = new int[n];
    }

    cout << "Enter the elements of the matrix:" << endl;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> matrix[i][j];
        }
    }

    bool isDiagonal = true;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            // العناصر خارج القطر الرئيسي يجب أن تكون صفراً
            if (i != j && matrix[i][j] != 0) {
                isDiagonal = false;
                break;
            }
        }
        if (!isDiagonal) break;
    }

    if (isDiagonal) {
        cout << "The matrix is a Diagonal Matrix." << endl;
    } else {
        cout << "The matrix is NOT a Diagonal Matrix." << endl;
    }

    // تحرير الذاكرة
    for (int i = 0; i < n; i++) {
        delete[] matrix[i];
    }
    delete[] matrix;

    return 0;
}
